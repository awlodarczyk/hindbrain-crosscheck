    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "tailwindcss": "4",
