{
  "name": "hindbrain-crosscheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4173",
