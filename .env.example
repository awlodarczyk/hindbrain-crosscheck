# Runtime mode: local (single user) or hosted (multi-user). Default: local
APP_MODE=local
# HTTP port. Default: 4173
PORT=4173
# Directory for local data. Default: ./data
DATA_DIR=./data
# Signing secret, min 32 chars. generate with: openssl rand -base64 48
APP_SECRET=
# Public base URL of the app (required in hosted mode)
APP_URL=
# Trust X-Forwarded-* headers from a reverse proxy: 0 or 1. Default: 0
TRUST_PROXY=0
# Enable CLI-based providers: 0 or 1. Default: 1
CLI_ENABLED=1
# Provider transport: auto or mock. Default: auto
PROVIDER_TRANSPORT=auto
# Mock transport test knobs: per-call delay in ms, and a provider (claude or chatgpt) whose calls fail
MOCK_DELAY_MS=0
MOCK_FAIL=
# Anthropic API key (optional)
ANTHROPIC_API_KEY=
# OpenAI API key (optional)
OPENAI_API_KEY=
# SMTP connection URL for email (optional), e.g. smtp://user:pass@host:587
SMTP_URL=
# Log level: fatal, error, warn, info, debug, trace. Default: info
LOG_LEVEL=info

# Hosted mode (APP_MODE=hosted)
# Valkey/Redis URL (required), e.g. redis://valkey:6379
VALKEY_URL=
# Initial admin email (required)
ADMIN_EMAIL=
# Initial admin password, min 12 chars (required)
ADMIN_PASSWORD=
