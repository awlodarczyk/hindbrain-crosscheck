# staging environment for Dokploy (Environment tab). Placeholders only; never commit real values.
# Compose pins APP_MODE=hosted, TRUST_PROXY=1, CLI_ENABLED=0, DATA_DIR=/data, VALKEY_URL.
APP_MODE=hosted
PORT=3000
DATA_DIR=/data
# Signing secret, min 32 chars: openssl rand -base64 48
APP_SECRET=change-me-change-me-change-me-change-me
APP_URL=https://crosscheck-staging.example.com
# Required in hosted mode: app runs behind Traefik (last x-forwarded-for hop is trusted).
TRUST_PROXY=1
CLI_ENABLED=0
# Password for the bundled Valkey; use URL-safe characters (openssl rand -hex 24).
VALKEY_PASSWORD=change-me
VALKEY_URL=redis://:change-me@valkey:6379/0
PROVIDER_TRANSPORT=auto
MOCK_DELAY_MS=0
# MOCK_FAIL=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# First deploy only: sign in, then remove ADMIN_PASSWORD (and optionally ADMIN_EMAIL) and redeploy.
# The admin user persists in the database.
ADMIN_EMAIL=admin@example.com
# Min 12 chars.
ADMIN_PASSWORD=change-me-change-me
# SMTP_URL=smtp://user:change-me@smtp.example.com:587
LOG_LEVEL=debug
